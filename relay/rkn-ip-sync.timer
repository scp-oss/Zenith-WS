[Unit]
Description=Ночной запуск rkn-ip-sync.service (см. cidr/rkn_ip_sync.sh)

[Timer]
# Прямой запрос -- "пусть это будет в фоне ночью": один прогон на
# ~20 тыс. кандидатов может занять от получаса до пары часов (таймауты,
# не успешные коннекты, съедают время -- см. докстринг rkn_ip_sync.sh),
# нежелательно занимать интерактивную сессию или конкурировать с дневным
# трафиком/тестами стратегий. RandomizedDelaySec размывает точный момент
# старта -- не принципиально для одного сервера сейчас, но безобидная
# гигиена на случай, если этот же юнит когда-нибудь окажется на
# нескольких серверах разом (не разовый скоординированный вал SYN на одни
# и те же внешние адреса со всех них одновременно).
OnCalendar=*-*-* 03:00:00
RandomizedDelaySec=1800
Persistent=true

[Install]
WantedBy=timers.target
