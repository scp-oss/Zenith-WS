[Unit]
Description=Transparent Telegram MTProto relay (no-secret connector, Zenith-WS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wsrelay
Group=wsrelay
WorkingDirectory=/opt/Zenith-WS/relay
# ZWS_CF_WORKER_HOST / ZWS_CF_WORKER_SECRET (опционально, см.
# cf_worker/README.md) -- fallback через Cloudflare Worker для
# passthrough-трафика (напр. web.telegram.org), когда прямой TCP с этой
# машины заблокирован на уровне null-route. Файл может не существовать --
# ведущий "-" делает EnvironmentFile необязательным, без ошибки старта.
EnvironmentFile=-/etc/z2r_autobench/wsrelay.env
ExecStart=/opt/Zenith-WS/.venv/bin/python -u transparent_relay.py --host 127.0.0.1 --port 8447
Restart=on-failure
RestartSec=5
# Прозрачный passthrough (см. transparent_relay.py::_passthrough_plain_tcp)
# держит по 2 сокета (клиент + upstream) на КАЖДОЕ соединение, включая
# обычный браузерный HTTPS ко всему, что попало в тот же CIDR, что и
# Telegram (напр. web.telegram.org сам по себе открывает десятки
# параллельных соединений) -- дефолтный лимит systemd (обычно 1024)
# исчерпывается быстро ("Too many open files"), живой случай на Server A.
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/Zenith-WS
ProtectHome=true

[Install]
WantedBy=multi-user.target
